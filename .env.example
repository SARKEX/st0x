
# CSRF token signing secret (CSRF_SECRET preferred; SESSION_SECRET is a legacy fallback)
SESSION_SECRET=
PUBLIC_WALLETCONNECT_ID=
PRIVATE_PINATA_JWT=
PUBLIC_PINATA_GATEWAY_URL=
PRIVATE_PINATA_GATEWAY_KEY=

# Debug auth-hook logging (set to 'true' to enable logging)
DEBUG_LOGIN=

# Privy (embedded wallets)
PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

PUBLIC_DYNAMIC_ENVIRONMENT_ID=

PUBLIC_POSTHOG_KEY=

# ST0x REST service traffic
ST0X_API_URL=
# General authenticated website proxy, registry, and orderbook traffic.
ST0X_API_KEY=
ST0X_API_SECRET=
# Dedicated public trade-activity refresh budget. Configure both values in production.
# If both are absent, the general pair is used only as a rollout fallback.
ST0X_ACTIVITY_API_KEY=
ST0X_ACTIVITY_API_SECRET=
# Dedicated public-price refresh budget. Configure both values in production.
# If both are absent, the general pair is used only as a rollout fallback.
ST0X_PRICES_API_KEY=
ST0X_PRICES_API_SECRET=

# Liquidity monitor (SPYM price source)

# Observability — Sentry (errors)
# Required for Sentry error tracking — see https://sentry.io/signup/
# Server-side DSN (Sentry Dashboard → Project Settings → Client Keys (DSN)).
SENTRY_DSN=
# Same DSN value as SENTRY_DSN; PUBLIC_-prefixed for client-side bundling.
PUBLIC_SENTRY_DSN=
# Build-time only (Sentry Dashboard → Settings → Auth Tokens; scopes: project:write + project:releases).
# Sourcemap upload is gated on this token; PR previews / local builds without it skip upload (Pitfall 4).
SENTRY_AUTH_TOKEN=
# Sentry org slug (visible in dashboard URL).
SENTRY_ORG=
# Sentry project slug.
SENTRY_PROJECT=

# Observability — Telegram bot for chain-exhausted RPC alerts (OBS-04 / D-09 + D-17).
# Provision:
#   1. Talk to @BotFather on Telegram → /newbot → name + handle → save the bot token.
#   2. Add the bot to your team alerts group/channel.
#   3. Get the chat_id: in the alerts group, send a message; then GET
#      https://api.telegram.org/bot<TOKEN>/getUpdates and read result[].message.chat.id
#      (negative for groups/channels, positive for direct messages).
# Server-side env (set in Vercel project). Either var missing in prod → alerts no-op
# (logged via pino at error level); does NOT kill cold-start.
OBSERVABILITY_ALERT_TELEGRAM_BOT_TOKEN=
OBSERVABILITY_ALERT_TELEGRAM_CHAT_ID=

# Server-only Base mainnet RPC — Alchemy app URL (or compatible). Browser-side
# wagmi/viem reads use the ordered RPC list in the active public registry.
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY_HERE

# Public Rain strategy registry URL. By default /registry/manifest resolves the
# REST API's active source commit to the matching immutable st0x.registry manifest.
# Override only for staging tests against an alternate public registry.
# Example (dia-limit DiaWords bump — st0x.registry PR #41):
# PUBLIC_REGISTRY_URL=https://raw.githubusercontent.com/ST0x-Technology/st0x.registry/a9d9e29aa44d0bba784f030d71128b247fd3c9a4/registry
