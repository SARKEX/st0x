
# Basic Auth for Vercel middleware (set in Vercel dashboard per-env)
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
SESSION_SECRET=
PUBLIC_WALLETCONNECT_ID=
PRIVATE_PINATA_JWT=
PUBLIC_PINATA_GATEWAY_URL=
PRIVATE_PINATA_GATEWAY_KEY=

# Enable custom SvelteKit login (disables Vercel Basic Auth middleware when true)
CUSTOM_LOGIN_ENABLED=

# Debug login issues (set to 'true' to enable logging)
DEBUG_LOGIN=

# Dynamic (embedded wallets)
PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# Onramper (fiat on-ramp)
PUBLIC_ONRAMPER_API_KEY=
ONRAMPER_SECRET_KEY=
# Set to 'production' for live Onramper, anything else uses sandbox
PUBLIC_ONRAMPER_ENV=

# LP Attribution Subgraph (deposit-based pool rewards tracking)
# Goldsky subgraph for tracking LP deposits in Aerodrome pools
LP_SUBGRAPH_URL=https://api.goldsky.com/api/public/project_cmjr2df7svg6t01tl2ic706ao/subgraphs/st0x-rewards-base/1.0.23/gn

# =============================================================================
# Account Abstraction (Rhinestone)
# =============================================================================

# Rhinestone - Cross-chain swaps and account abstraction
# Get API key from: https://www.rhinestone.dev/
PUBLIC_RHINESTONE_API_KEY=

# Enable USDC gas sponsorship (requires depositing USDC to Rhinestone)
PUBLIC_RHINESTONE_SPONSORSHIP_ENABLED=true

# Account type: '7702' for EIP-7702 smart EOA, 'smart' for new smart account
PUBLIC_RHINESTONE_ACCOUNT_TYPE=7702


# Alchemy - Used for bundler and provider (optional, enhances performance)
# Get API key from: https://www.alchemy.com/
PUBLIC_ALCHEMY_API_KEY=
