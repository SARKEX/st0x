
# Basic Auth for Vercel middleware (set in Vercel dashboard per-env)
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
SESSION_SECRET=
PUBLIC_WALLETCONNECT_ID=
PRIVATE_PINATA_JWT=
PUBLIC_PINATA_GATEWAY_URL=
PRIVATE_PINATA_GATEWAY_KEY=

# Enable custom SvelteKit login (disables Vercel Basic Auth middleware when true)
CUSTOM_LOGIN_ENABLED=

# Debug login issues (set to 'true' to enable logging)
DEBUG_LOGIN=

# Privy (embedded wallets)
PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

PUBLIC_DYNAMIC_ENVIRONMENT_ID=

PUBLIC_POSTHOG_KEY=

# Liquidity monitor (SPYM price source)
LIQUIDITY_MONITOR_URL=

# Observability — Sentry (errors)
# Required for Sentry error tracking — see https://sentry.io/signup/
# Server-side DSN (Sentry Dashboard → Project Settings → Client Keys (DSN)).
SENTRY_DSN=
# Same DSN value as SENTRY_DSN; PUBLIC_-prefixed for client-side bundling.
PUBLIC_SENTRY_DSN=
# Build-time only (Sentry Dashboard → Settings → Auth Tokens; scopes: project:write + project:releases).
# Sourcemap upload is gated on this token; PR previews / local builds without it skip upload (Pitfall 4).
SENTRY_AUTH_TOKEN=
# Sentry org slug (visible in dashboard URL).
SENTRY_ORG=
# Sentry project slug.
SENTRY_PROJECT=

# Observability — Telegram bot for chain-exhausted RPC alerts (OBS-04 / D-09 + D-17).
# Provision:
#   1. Talk to @BotFather on Telegram → /newbot → name + handle → save the bot token.
#   2. Add the bot to your team alerts group/channel.
#   3. Get the chat_id: in the alerts group, send a message; then GET
#      https://api.telegram.org/bot<TOKEN>/getUpdates and read result[].message.chat.id
#      (negative for groups/channels, positive for direct messages).
# Server-side env (set in Vercel project). Either var missing in prod → alerts no-op
# (logged via pino at error level); does NOT kill cold-start.
OBSERVABILITY_ALERT_TELEGRAM_BOT_TOKEN=
OBSERVABILITY_ALERT_TELEGRAM_CHAT_ID=

# Base mainnet RPC — Alchemy app URL (or compatible). Same value used on both sides per
# Phase 3 D-02 (single key both sides; bundle key is exposed regardless, splitting doubles
# operational surface for marginal blast-radius reduction).
PUBLIC_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY_HERE
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY_HERE

# Rain strategies registry URL. Defaults to '/registry/manifest' (same-origin Vercel static).
# Override only for staging tests against an alternate registry; production should use the default.
# Refresh procedure: see 03-RUNBOOK.md "Registry Refresh" (Plan 03-11).
# PUBLIC_REGISTRY_URL=/registry/manifest
