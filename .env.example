
# Basic Auth for Vercel middleware (set in Vercel dashboard per-env)
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
SESSION_SECRET=
PUBLIC_WALLETCONNECT_ID=
PRIVATE_PINATA_JWT=
PUBLIC_PINATA_GATEWAY_URL=
PRIVATE_PINATA_GATEWAY_KEY=

# Enable custom SvelteKit login (disables Vercel Basic Auth middleware when true)
CUSTOM_LOGIN_ENABLED=

# Debug login issues (set to 'true' to enable logging)
DEBUG_LOGIN=

# Privy (embedded wallets)
PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Coinbase On-ramp / Off-ramp (CDP API)
# API Key ID from Coinbase Developer Platform (Ed25519 format)
CDP_API_KEY_ID=
# Ed25519 private key (PEM format) from Coinbase Developer Platform
CDP_API_KEY_SECRET=
PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# LP Attribution Subgraph (deposit-based pool rewards tracking)
# Goldsky subgraph for tracking LP deposits in Aerodrome pools
LP_SUBGRAPH_URL=https://api.goldsky.com/api/public/project_cmjr2df7svg6t01tl2ic706ao/subgraphs/st0x-rewards-base/1.0.23/gn

PUBLIC_POSTHOG_KEY=
